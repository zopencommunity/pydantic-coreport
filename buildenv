# bump: pydantic-core-version /PYDANTIC_CORE_VERSION="(.*)"/ https://github.com/pydantic/pydantic-core.git|semver:*
PYDANTIC_CORE_VERSION="2.41.5"

###
### Build control file for pydantic-coreport
###
### pydantic-core is a Rust extension and cannot be compiled natively on z/OS
### (no native Rust toolchain). Prebuilt wheels are cross-compiled on
### Linux-on-Power (LoP) using IBM's Rust cross-compiler targeting s390x-ibm-zos
### and uploaded as release assets on this repo.
###
### Pattern mirrors fdport/ripgrepport: ZOPEN_TYPE=BARE, zopen_init downloads
### the prebuilt artifact, zopen_custom_install places it.
###
### Cross-compilation infrastructure:
###   https://github.ibm.com/compiler/rust-scripts  branch itodorov/zos-cross-compile-setup
###
### Note: 2.41.5 is the newest release buildable with rustc 1.86 (rust-version="1.75").
### 2.42.0+ requires rustc 1.88.
###

export ZOPEN_PROJECT_NAME="pydantic-core"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_TYPE="BARE"
# Required even though nothing is fetched from it. checkEnv exempts only
# ZOPEN_TYPE=LOCAL from needing a URL, so a BARE port without one fails with
# "Building from stable, but ZOPEN_STABLE_URL not specified" before it does
# anything. getCode returns early for BARE and never clones it, so this records
# which upstream source the prebuilt wheels were cross-compiled from -- the
# same arrangement fdport uses.
export ZOPEN_STABLE_URL="https://github.com/pydantic/pydantic-core.git"
export ZOPEN_STABLE_TAG="v${PYDANTIC_CORE_VERSION}"
export ZOPEN_DEV_URL="https://github.com/pydantic/pydantic-core.git"
export ZOPEN_STABLE_DEPS="check_python curl"
export ZOPEN_DEV_DEPS="check_python curl"
export ZOPEN_CATEGORIES="development library"
export ZOPEN_RUNTIME_DEPS="check_python"

export ZOPEN_CONFIGURE="skip"
export ZOPEN_MAKE="skip"
export ZOPEN_CHECK="zopen_custom_check"
export ZOPEN_INSTALL="zopen_custom_install"

zopen_get_version() {
  echo "${PYDANTIC_CORE_VERSION}"
}

zopen_init() {
  # Ask the interpreter for its own tag rather than parsing --version: z/OS
  # grep has no -o (FSUMA930), and grep is only pulled in implicitly for the
  # Python build system, which this port does not use. Parsing would also have
  # to cope with IBM's banner, "IBM Open Enterprise SDK for Python 3.12.13".
  _py=$(python3 -c 'import sys; print("%d%d" % sys.version_info[:2])') || return 1
  _wheel="pydantic_core-${PYDANTIC_CORE_VERSION}-cp${_py}-none-any.whl"
  _url="https://github.com/zopencommunity/pydantic-coreport/releases/download/v${PYDANTIC_CORE_VERSION}/${_wheel}"

  printInfo "Downloading ${_wheel}"
  curl -fsSL -o "${_wheel}" "${_url}" || {
    printError "Failed to download ${_wheel}"
    printError "Only cp312 is published today: pydantic-core has no abi3 build, so"
    printError "one .so cannot serve several interpreters and each needs its own"
    printError "cross-compile. Build it on LoP with build_zos_wheel.py and attach"
    printError "it to the v${PYDANTIC_CORE_VERSION} release."
    return 1
  }
  # A wheel is a zip. Tagging it as ISO8859-1 text invites conversion on read;
  # fdport marks its downloaded artifact binary for the same reason.
  chtag -b "${_wheel}" 2>/dev/null || true
}

zopen_custom_check() {
  # Find the wheel we downloaded
  _wheel=$(ls pydantic_core-*.whl 2>/dev/null | head -1)
  [ -n "${_wheel}" ] || { printError "No wheel found"; return 1; }

  # Create a throwaway venv, install the wheel, run smoke tests
  python3 -m venv .check_venv
  . .check_venv/bin/activate

  pip install --quiet --no-deps "${_wheel}"

  python3 - <<'PYEOF'
import sys

try:
    import pydantic_core
    from pydantic_core import SchemaValidator, core_schema
except ImportError as exc:
    print("FAIL: import pydantic_core -", exc, file=sys.stderr)
    sys.exit(1)

failures = 0

def check(label, expr):
    global failures
    if expr:
        print("PASS:", label)
    else:
        print("FAIL:", label, file=sys.stderr)
        failures += 1

v = SchemaValidator(core_schema.str_schema())
check("str validate_python", v.validate_python("hello") == "hello")
check("str validate_json",   v.validate_json('"world"') == "world")

v2 = SchemaValidator(core_schema.int_schema())
check("int validate_python", v2.validate_python(42) == 42)

try:
    v2.validate_python("not-an-int")
    check("ValidationError raised", False)
except pydantic_core.ValidationError:
    check("ValidationError raised", True)

person = SchemaValidator(core_schema.typed_dict_schema({
    "name": core_schema.typed_dict_field(core_schema.str_schema()),
    "age":  core_schema.typed_dict_field(core_schema.int_schema()),
}))
r = person.validate_python({"name": "z/OS", "age": 1})
check("typed_dict name", r["name"] == "z/OS")
check("typed_dict age",  r["age"]  == 1)

print()
print("pydantic_core %s on Python %s  --  %d passed, %d failed" % (
    pydantic_core.__version__, sys.version.split()[0], 6 - failures, failures))
sys.exit(failures)
PYEOF
  _rc=$?
  deactivate
  rm -rf .check_venv
  return ${_rc}
}

zopen_custom_install() {
  _wheel=$(ls pydantic_core-*.whl 2>/dev/null | head -1)
  [ -n "${_wheel}" ] || { printError "No wheel found to install"; return 1; }

  # Install the wheel into the port tree
  mkdir -p "${ZOPEN_INSTALL_DIR}/lib/python"
  python3 -m pip install --quiet --no-deps --target="${ZOPEN_INSTALL_DIR}/lib/python" "${_wheel}"

  # Stage the wheel for the zopen wheel index, in the port's artifact directory
  # next to the pax and metadata.json -- which is where CI looks
  # (install/dist/*.whl). It must NOT go under ZOPEN_INSTALL_DIR: that tree is
  # what gets packaged, so a wheel there ships a second copy of everything
  # already under lib/python and is invisible to CI, which is what
  # zopen-build's own _zopen_python_install warns about.
  mkdir -p "${ZOPEN_ROOT}/install/dist"
  cp "${_wheel}" "${ZOPEN_ROOT}/install/dist/"

  printInfo "Installed pydantic_core ${PYDANTIC_CORE_VERSION} from ${_wheel}"
}

# Without ZOPEN_BUILD_SYSTEM="Python" nothing adds lib/python to PYTHONPATH --
# zopen-build only supplies that .env snippet for Python-build-system ports --
# so the module would be installed and still not importable, and the install
# validation below would fail.
zopen_append_to_env() {
  cat <<ZZ
PYTHONPATH="\${PYTHONPATH}:\${PWD}/lib/python"
export PYTHONPATH="\$(deleteDuplicateEntries "\$PYTHONPATH" ":")"
ZZ
}

zopen_append_to_validate_install() {
  echo "python3 -c \"import pydantic_core; print('pydantic_core', pydantic_core.__version__)\""
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="${dir}/${pfx}_check.log"
  # No "|| echo 0": grep -c already prints 0 when nothing matches, and it also
  # exits 1, so the fallback appended a second zero and the arithmetic below
  # died with FSUM9224 bad number "0\n0". That fired on every clean run, since
  # a clean run has no FAIL: lines at all.
  passed=$(grep -c "^PASS:" "${chk}" 2>/dev/null)
  failed=$(grep -c "^FAIL:" "${chk}" 2>/dev/null)
  passed=${passed:-0}
  failed=${failed:-0}
  total=$((passed + failed))
  echo "actualFailures:${failed}"
  echo "totalTests:${total}"
  echo "expectedFailures:0"
}
