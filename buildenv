# bump: pydantic-core-version /PYDANTIC_CORE_VERSION="(.*)"/ https://github.com/pydantic/pydantic-core.git|semver:*
PYDANTIC_CORE_VERSION="2.46.4"

###
### Build control file for pydantic-coreport
###
### pydantic-core is a Rust extension and cannot be compiled natively on z/OS
### (no native Rust toolchain). Prebuilt wheels are cross-compiled on
### Linux-on-Power (LoP) using IBM's Rust cross-compiler targeting s390x-ibm-zos
### and uploaded as release assets on this repo.
###
### Same BARE arrangement as fdport and cryptographyport. Keeping
### ZOPEN_BUILD_SYSTEM="Python" matters: it is what stages a wheel per
### interpreter for the wheel index and runs the check once per interpreter. A
### cross-compiled binary nobody loaded is the main risk here, so nothing is
### published until the interpreter it claims to support has actually
### validated data with it.
###
### Cross-compilation infrastructure:
###   https://github.ibm.com/compiler/rust-scripts  branch itodorov/zos-cross-compile-setup
###
### Note: 2.41.5 is the newest release buildable with rustc 1.86 (rust-version="1.75").
### 2.42.0+ requires rustc 1.88.
###

export ZOPEN_PROJECT_NAME="pydantic-core"
# BARE has no source directory to take a name from, so zopen-build falls back to
# the directory holding this buildenv -- "pydantic-coreport" -- and never appends the
# version, because only GIT and LOCAL do that. The pax and the installed
# version directory then come out as "pydantic-coreport" instead of "pydantic-core-<version>".
# fdport, the reference BARE port, sets this for the same reason.
export ZOPEN_NAME="pydantic-core-${PYDANTIC_CORE_VERSION}"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_TYPE="BARE"
# ZOPEN_TYPE alone does not hold. For a named build line zopen-build overwrites
# it: with no ZOPEN_STABLE_TYPE it infers the type from ZOPEN_STABLE_URL, and a
# URL ending in .git becomes GIT. This port has therefore been cloning pydantic/pydantic-core
# every build despite declaring itself BARE.
#
# Nothing broke here only because pydantic-core keeps its package under python/. A repo
# with its package at the root shadows the installed wheel during the check,
# because zopen_python_test feeds its script to python on stdin and python puts
# the working directory first on sys.path -- that is exactly what happened to
# watchfilesport, and it presented as a broken wheel.
export ZOPEN_STABLE_TYPE="BARE"
export ZOPEN_DEV_TYPE="BARE"
# Required even though nothing is fetched from it. checkEnv exempts only
# ZOPEN_TYPE=LOCAL from needing a URL, so a BARE port without one fails with
# "Building from stable, but ZOPEN_STABLE_URL not specified" before it does
# anything. getCode returns early for BARE and never clones it, so this records
# which upstream source the prebuilt wheels were cross-compiled from -- the
# same arrangement fdport uses.
export ZOPEN_STABLE_URL="https://github.com/pydantic/pydantic-core.git"
export ZOPEN_STABLE_TAG="v${PYDANTIC_CORE_VERSION}"
export ZOPEN_DEV_URL="https://github.com/pydantic/pydantic-core.git"
export ZOPEN_STABLE_DEPS="check_python curl"
export ZOPEN_DEV_DEPS="check_python curl"
export ZOPEN_CATEGORIES="development library"
export ZOPEN_RUNTIME_DEPS="check_python"

export ZOPEN_BUILD_SYSTEM="Python"
export ZOPEN_BOOTSTRAP="skip"
export ZOPEN_CONFIGURE="skip"
export ZOPEN_COMP="skip"
export ZOPEN_MAKE="zopen_custom_build"

WHEEL_BASE_URL="https://github.com/zopencommunity/pydantic-coreport/releases/download/v${PYDANTIC_CORE_VERSION}"

zopen_get_version() {
  echo "${PYDANTIC_CORE_VERSION}"
}

# The platform tag in a native wheel's name is not a constant, so it cannot be
# written literally here. 3.12 and 3.13 report os390_<release>_<model> while
# 3.14 reports plain "zos", and the model field names the machine that built
# the wheel rather than anything about this port -- 8561 is a machine type, so
# a rebuild on different hardware moves the name again.
#
# Ask the interpreter what it calls this platform, then fall back to the tags
# actually in use. Whichever exists is the right one.
_pc_platform_tags() {
  _pt_local=$("$(_zopen_python_interpreter_path "$1")" -c \
    'import sysconfig; print(sysconfig.get_platform().replace("-","_").replace(".","_"))' \
    2>/dev/null)
  echo "${_pt_local} zos os390_29_00_8561"
}

# Fetch one prebuilt wheel per interpreter, under its native name. Do not fetch
# a hand-renamed -none-any asset: renaming a wheel leaves the internal WHEEL
# metadata still declaring the original platform tag, which is malformed per
# PEP 427, and it does not self-heal because retagging treats a -none-any name
# carrying a cp3XY python tag as already done. Letting
# _zopen_python_retag_wheel do it rewrites the filename, the WHEEL metadata and
# RECORD together.
zopen_init() {
  mkdir -p wheels || return 1
  for _pv in $(_zopen_python_versions); do
    _tag="cp$(echo "${_pv}" | tr -d '.')"

    # already fetched on an earlier run, under whatever tag it carries
    _have=""
    for _cand in wheels/pydantic_core-${PYDANTIC_CORE_VERSION}-${_tag}-${_tag}-*.whl; do
      [ -f "${_cand}" ] && { _have="${_cand}"; break; }
    done
    [ -n "${_have}" ] && continue

    _tried=""
    _got=""
    for _plat in $(_pc_platform_tags "${_pv}"); do
      case " ${_tried} " in *" ${_plat} "*) continue ;; esac
      _tried="${_tried} ${_plat}"
      _whl="pydantic_core-${PYDANTIC_CORE_VERSION}-${_tag}-${_tag}-${_plat}.whl"
      if curl -fsSL -o "wheels/${_whl}" "${WHEEL_BASE_URL}/${_whl}" 2>/dev/null; then
        printInfo "Fetched ${_whl}"
        # A wheel is a zip; tagging it as text invites conversion on read.
        chtag -b "wheels/${_whl}"
        _got="${_whl}"
        break
      fi
      rm -f "wheels/${_whl}"
    done

    if [ -z "${_got}" ]; then
      printSoftError "No prebuilt wheel for Python ${_pv} at ${WHEEL_BASE_URL}"
      printSoftError "Tried platform tags:${_tried}"
      printSoftError "pydantic-core has no abi3 build -- a Rust extension is compiled"
      printSoftError "against one CPython ABI -- so each interpreter needs its own"
      printSoftError "cross-compile attached to the v${PYDANTIC_CORE_VERSION} release."
      return 1
    fi
  done
}

# pydantic_core imports typing_extensions at module level and the interpreters
# do not bundle it, so an isolated venv cannot import the wheel at all. It is
# pure Python with no dependencies of its own, so one small wheel from PyPI
# settles it. --system-site-packages costs nothing here and keeps this port's
# venvs consistent with cryptographyport's.
_pc_venv_for() {
  _cv_dir=$(_zopen_python_venv_dir "$1")
  if [ ! -f "${_cv_dir}/bin/activate" ]; then
    printInfo "Creating virtual environment for ${1} in ${_cv_dir} (with system packages)"
    "$(_zopen_python_interpreter_path "$1")" -m venv --system-site-packages "${_cv_dir}" || return 1
  fi
  . "${_cv_dir}/bin/activate" || return 1
  pip install --disable-pip-version-check --quiet setuptools build installer wheel typing_extensions
}

# Stands in for compiling. Everything the Python build system would do is still
# done -- verify the interpreters, create a virtual environment for each, put
# that interpreter's wheel in dist/, retag -- except the compiling itself. The
# per-interpreter venv is not optional: the check phase runs in it and fails
# with "No virtual environment at .venv-3.13" without it.
zopen_custom_build() {
  _zopen_python_verify_interpreters || return 1

  rm -rf dist
  mkdir -p dist || return 1

  for _pv in $(_zopen_python_versions); do
    _pc_venv_for "${_pv}" || return 1
    _tag="cp$(echo "${_pv}" | tr -d '.')"
    # Glob rather than reconstruct the name: zopen_init already resolved which
    # platform tag exists, and it is not the same for every interpreter.
    _src=""
    for _cand in wheels/pydantic_core-${PYDANTIC_CORE_VERSION}-${_tag}-${_tag}-*.whl; do
      [ -f "${_cand}" ] && { _src="${_cand}"; break; }
    done
    if [ -z "${_src}" ]; then
      printSoftError "No wheel staged for Python ${_pv} in wheels/"
      deactivate
      return 1
    fi
    cp "${_src}" dist/ || { deactivate; return 1; }
    printInfo "Staged $(basename "${_src}") for Python ${_pv}"
    deactivate
  done

  # Retag to cp3XY-none-any so a wheel is not pinned to the z/OS release and
  # machine model of the box that produced it. The tag is read from each
  # wheel's own filename, so the interpreter active here does not matter.
  _pc_venv_for "$(_zopen_python_primary_version)" || return 1
  _zopen_python_retag_wheel
  _rc=$?
  deactivate
  return ${_rc}
}

# Called once per interpreter, with that interpreter's environment active and
# its wheel already installed. Loading the extension and validating real data
# is the point: it is the only thing that shows a wheel built off-platform
# works on this one.
zopen_python_test() {
  PYDANTIC_CORE_EXPECTED_VERSION="${PYDANTIC_CORE_VERSION}" python - <<'PYEOF'
import os
import sys

# The check exists to exercise the *installed* wheel, so the working directory
# has no business being importable. python reads this script from stdin and so
# puts "" first on sys.path; if a source tree with this package at its root
# ever sits beside the build, the import silently resolves there instead and
# fails as though the wheel had no extension.
sys.path = [p for p in sys.path if p not in ("", ".")]

failures = 0
total = 0


def check(label, fn):
    global failures, total
    total += 1
    try:
        if fn():
            print("PASS:", label)
        else:
            print("FAIL:", label, file=sys.stderr)
            failures += 1
    except Exception as exc:
        print("FAIL:", label, "-", exc, file=sys.stderr)
        failures += 1


try:
    import pydantic_core
    from pydantic_core import SchemaValidator, core_schema
except ImportError as exc:
    # Report as a failure rather than crashing, so zopen_check_results sees a
    # count instead of an empty log.
    print("FAIL: import pydantic_core -", exc, file=sys.stderr)
    print("pydantic_core FAILED to import on Python %s" % sys.version.split()[0])
    sys.exit(1)

expected = os.environ["PYDANTIC_CORE_EXPECTED_VERSION"]

# The venv can see the interpreter's own site-packages, so a wheel that failed
# to install would leave some other pydantic_core importable and every check
# below would pass against it. Assert we are testing what this port ships.
check("version is the one this port builds",
      lambda: pydantic_core.__version__ == expected)

v = SchemaValidator(core_schema.str_schema())
check("str validate_python", lambda: v.validate_python("hello") == "hello")
check("str validate_json", lambda: v.validate_json('"world"') == "world")

v2 = SchemaValidator(core_schema.int_schema())
check("int validate_python", lambda: v2.validate_python(42) == 42)
check("int coerces from str", lambda: v2.validate_python("42") == 42)


def rejects_bad_int():
    try:
        v2.validate_python("not-an-int")
        return False
    except pydantic_core.ValidationError:
        return True


check("ValidationError raised", rejects_bad_int)

person = SchemaValidator(core_schema.typed_dict_schema({
    "name": core_schema.typed_dict_field(core_schema.str_schema()),
    "age": core_schema.typed_dict_field(core_schema.int_schema()),
}))
r = person.validate_python({"name": "z/OS", "age": 1})
check("typed_dict name", lambda: r["name"] == "z/OS")
check("typed_dict age", lambda: r["age"] == 1)

print()
print("pydantic_core %s on Python %s  --  %d passed, %d failed" % (
    pydantic_core.__version__, sys.version.split()[0], total - failures, failures))
sys.exit(1 if failures else 0)
PYEOF
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="${dir}/${pfx}_check.log"
  # No "|| echo 0": grep -c already prints 0 when nothing matches, and it also
  # exits 1, so the fallback appended a second zero and the arithmetic below
  # died with FSUM9224 bad number "0\n0". That fired on every clean run, since
  # a clean run has no FAIL: lines at all.
  passed=$(grep -c "^PASS:" "${chk}" 2>/dev/null)
  failed=$(grep -c "^FAIL:" "${chk}" 2>/dev/null)
  passed=${passed:-0}
  failed=${failed:-0}
  total=$((passed + failed))

  # An interpreter whose test produced no lines at all did not pass, it never
  # ran. Reporting 0/0 as success is how a broken wheel ships.
  interpreters=$(grep -c "^pydantic_core .* on Python" "${chk}" 2>/dev/null)
  interpreters=${interpreters:-0}
  expected=$(echo "${ZOPEN_PYTHON_VERSIONS:-3.12 3.13 3.14}" | wc -w | tr -d ' ')
  if [ "${interpreters}" -lt "${expected}" ]; then
    silent=$((expected - interpreters))
    failed=$((failed + silent))
    total=$((total + silent))
  fi

  echo "actualFailures:${failed}"
  echo "totalTests:${total}"
  echo "expectedFailures:0"
}

# The wheels record the extension executable, but pip is not the only thing
# that puts it in place: zopen packages ZOPEN_INSTALL_DIR into the pax. Make
# sure the bit survives that, or the module fails to HFS-load with
# CEE3512S ... reason code EF076015, which reads like a missing symbol.
zopen_post_install() {
  for _so in "${ZOPEN_INSTALL_DIR}"/lib/python/pydantic_core/*.so; do
    [ -f "${_so}" ] && chmod +x "${_so}"
  done

  # pydantic_core imports typing_extensions at module level, and nothing else
  # puts it in the package tree: zopen-build installs the wheel with --no-deps,
  # which is right in general -- zopen wants dependencies declared as ports --
  # but there is no typing_extensions port, and the interpreters do not bundle
  # it. Without this the pax installs a module that cannot be imported.
  #
  # It is pure Python with no dependencies of its own, so this is one small
  # wheel and it works on every interpreter from the same directory.
  if [ ! -d "${ZOPEN_INSTALL_DIR}/lib/python/typing_extensions" ] \
     && [ ! -f "${ZOPEN_INSTALL_DIR}/lib/python/typing_extensions.py" ]; then
    printInfo "Adding typing_extensions to the package tree"
    python3 -m pip install --disable-pip-version-check --quiet \
      --target="${ZOPEN_INSTALL_DIR}/lib/python" typing_extensions || return 1
  fi
  return 0
}

# Without ZOPEN_BUILD_SYSTEM="Python" nothing adds lib/python to PYTHONPATH --
# zopen-build only supplies that .env snippet for Python-build-system ports --
# so the module would be installed and still not importable, and the install
# validation below would fail.
zopen_append_to_env() {
  cat <<ZZ
PYTHONPATH="\${PYTHONPATH}:\${PWD}/lib/python"
export PYTHONPATH="\$(deleteDuplicateEntries "\$PYTHONPATH" ":")"
ZZ
}

zopen_append_to_validate_install() {
  echo "python3 -c \"import pydantic_core; print('pydantic_core', pydantic_core.__version__)\""
}
